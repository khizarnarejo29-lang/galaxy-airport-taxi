# Copy to .env.local and fill in. Never commit real values.

# Public base URL (used for canonical URLs and metadata).
NEXT_PUBLIC_SITE_URL=https://galaxyairporttaxi.co.uk

# Signs quotes and booking viewing passes so they can't be tampered with. 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production.
QUOTE_SIGNING_SECRET=

# Operator inbox for new-booking alerts and contact enquiries. Defaults to the site email.
BOOKINGS_NOTIFY_EMAIL=

# Sending email (booking confirmations, new-booking alerts, contact form) through a mailbox,
# e.g. Hostinger: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER=info@galaxyairporttaxi.co.uk.
# Without these, emails are only written to the server log. See docs/EMAIL-AND-ADMIN.md.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Password for the bookings page at /admin (10+ characters). Without it the page is off.
ADMIN_PASSWORD=

# Booking and quote-request storage: a MySQL / MariaDB database such as Hostinger's (see docs/DATABASE.md).
# SERVER-ONLY. Set all four; MYSQL_PORT is optional (3306).
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Or Supabase instead. SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# The secret key bypasses Row Level Security; keep it only in .env.local and the host's settings.
# Without both, development uses in-memory storage and production refuses online bookings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Card payments with Stripe Checkout (see docs/PAYMENTS.md). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# With both set (and booking storage configured), customers pay by card straight after booking.
# Without them, bookings are taken unpaid, to be paid as arranged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Future integrations (not used yet) ──
# EMAIL_API_KEY=
# GOOGLE_MAPS_API_KEY=
# FLIGHT_DATA_API_KEY=
